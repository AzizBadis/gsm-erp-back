ADMIN_SEED_PASSWORD="use-a-unique-password-of-at-least-16-characters"
GMAIL_SMTP_USER="your-gmail-address@gmail.com"
GMAIL_SMTP_APP_PASSWORD="your-16-character-gmail-app-password"
GMAIL_SMTP_FROM_NAME="GPS Tunisie"
COMPANY_NAME="GPS Tunisie"
COMPANY_ADDRESS="Rue Ali Ben Amara, El Menzah 9, Ariana 1013, Tunisie"
COMPANY_PHONE=""
COMPANY_EMAIL=""
