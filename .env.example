POSTGRES_USER="gsm_user"
POSTGRES_PASSWORD="replace-with-a-long-url-safe-password"
POSTGRES_DB="gsm_repair_erp"
BACKEND_PORT=3001
FRONTEND_PORT=8081
FRONTEND_CONTEXT="../gsm-erp"
VITE_API_URL="http://YOUR_SERVER_IP:3001"
JWT_SECRET="replace-with-a-long-random-jwt-secret"
